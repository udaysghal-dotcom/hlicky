# Copy to server/.env (never commit .env).

# Microburbs API key. `test` = free public sandbox (8 fixture properties, 9 suburbs,
# no /geocode/address — the resolver falls back to docs/sandbox-fixtures.md).
MICROBURBS_API_KEY=test

# Optional: where the Microburbs disk cache lives (default: server/.cache/microburbs).
# MICROBURBS_CACHE_DIR=
# Optional: cache TTL in hours (default 168 = 7 days).
# MICROBURBS_CACHE_TTL_HOURS=168
# Optional: `offline` = serve only from cache, never hit the network (demo replay).
# MICROBURBS_CACHE_MODE=
